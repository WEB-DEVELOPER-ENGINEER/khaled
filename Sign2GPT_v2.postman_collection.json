{
  "info": {
    "name": "Sign2GPT API",
    "description": "Sign Language Recognition + Arabic Translation API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://ahmedmoasd-sign2gpt.hf.space",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        },
        "description": "تأكد إن السيرفر شغال"
      }
    },
    {
      "name": "Get Classes",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/classes",
          "host": ["{{base_url}}"],
          "path": ["classes"]
        },
        "description": "قائمة الـ 100 كلمة"
      }
    },
    {
      "name": "Predict English",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/predict?top_k=5",
          "host": ["{{base_url}}"],
          "path": ["predict"],
          "query": [
            {
              "key": "top_k",
              "value": "5",
              "description": "عدد التوقعات (1-10)"
            }
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "description": "فيديو إشارة (.mp4 / .avi / .mov / .webm)"
            }
          ]
        },
        "description": "فيديو → كلمة إنجليزي"
      }
    },
    {
      "name": "Predict Arabic",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{base_url}}/predict_ar?top_k=5",
          "host": ["{{base_url}}"],
          "path": ["predict_ar"],
          "query": [
            {
              "key": "top_k",
              "value": "5",
              "description": "عدد التوقعات (1-10)"
            }
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "description": "فيديو إشارة (.mp4 / .avi / .mov / .webm)"
            }
          ]
        },
        "description": "فيديو → كلمة إنجليزي + عربي"
      }
    }
  ]
}
