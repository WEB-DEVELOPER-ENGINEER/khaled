{
  "openapi": "3.0.0",
  "info": {
    "title": "Sign2GPT API",
    "version": "1.0.0",
    "description": "API documentation for the Sign2GPT Backend"
  },
  "servers": [
    {
      "url": "http://91.108.113.135",
      "description": "Production server"
    },
    {
      "url": "http://localhost:5000",
      "description": "Local server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "NewSessionRequest": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "NewSessionResponse": {
        "type": "object",
        "required": ["success", "session_id"],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "session_id": {
            "type": "string"
          }
        }
      },
      "SendMessageRequest": {
        "type": "object",
        "required": ["session_id", "message"],
        "properties": {
          "session_id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SendMessageResponse": {
        "type": "object",
        "required": ["success", "session_id"],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "session_id": {
            "type": "string"
          },
          "reply": {
            "type": "string",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ChatHistoryMessage": {
        "type": "object",
        "required": ["role", "content", "timestamp"],
        "properties": {
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      },
      "ChatHistoryResponse": {
        "type": "object",
        "required": ["success", "session_id"],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "session_id": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatHistoryMessage"
            },
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "DeleteSessionResponse": {
        "type": "object",
        "required": ["success"],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Server is running"
          }
        }
      }
    },
    "/api/auth/signup": {
      "post": {
        "summary": "Register user",
        "tags": ["Auth"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/api/auth/verify/{token}": {
      "get": {
        "summary": "Verify email",
        "tags": ["Auth"],
        "parameters": [
          { "name": "token", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Verified" } }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login user",
        "tags": ["Auth"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Logged in" } }
      }
    },
    "/api/levels": {
      "get": {
        "summary": "Get all levels",
        "tags": ["Levels"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "List of levels" } }
      }
    },
    "/api/levels/all": {
      "get": {
        "summary": "Get all levels with their words and videos",
        "tags": ["Levels"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "List of all levels and their content" } }
      }
    },
    "/api/levels/{levelId}": {
      "get": {
        "summary": "Get level words",
        "tags": ["Levels"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "levelId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Words for level" } }
      }
    },
    "/api/submissions/verify": {
      "post": {
        "summary": "Verify sign attempt",
        "tags": ["Submissions"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "video": { "type": "string", "format": "binary" },
                  "expectedWord": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Verification result" } }
      }
    },
    "/api/submissions/classes": {
      "get": {
        "summary": "Get supported AI classes",
        "tags": ["Submissions"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "List of classes" } }
      }
    },
    "/api/submissions/predict": {
      "post": {
        "summary": "Free-form prediction (English)",
        "tags": ["Submissions"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "top_k", "in": "query", "schema": { "type": "integer", "default": 5 } }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "video": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Predictions" } }
      }
    },
    "/api/submissions/predict-ar": {
      "post": {
        "summary": "Free-form prediction (Arabic)",
        "tags": ["Submissions"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "top_k", "in": "query", "schema": { "type": "integer", "default": 5 } }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "video": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Predictions in Arabic" } }
      }
    },
    "/api/chat/new-session": {
      "post": {
        "summary": "Create a new chat session",
        "tags": ["Chatbot"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewSessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NewSessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Send a message and get reply",
        "tags": ["Chatbot"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reply received",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendMessageResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error"
          }
        }
      }
    },
    "/api/chat/history/{session_id}": {
      "get": {
        "summary": "Retrieve session history",
        "tags": ["Chatbot"],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session history retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatHistoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error"
          }
        }
      },
      "delete": {
        "summary": "Delete session history",
        "tags": ["Chatbot"],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Session history deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteSessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error"
          }
        }
      }
    }
  }
}